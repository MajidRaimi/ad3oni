# X_SESSION_STATE is produced by: uv run python scripts/save_x_session.py
# It contains live session cookies. Store it in Infisical, never in git.
X_ENABLED=false
X_HANDLE=ad3oni_
X_SESSION_STATE=
X_HEADLESS=true
X_DRY_RUN=false
